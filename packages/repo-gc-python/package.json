{
  "name": "repo-gc-python",
  "version": "0.2.7",
  "description": "Python language support for repo-gc — detects oversized files, dead modules, coupling hotspots, re-export chains, duplicate code, and unused imports",
  "license": "FSL-1.1-MIT",
  "repository": "https://github.com/repo-gc/repo-gc",
  "author": "repo-gc authors",
  "keywords": ["repo-gc", "python", "repository", "hygiene", "ai", "llm", "context", "code-quality", "analyzer", "cli"],
  "type": "module",
  "bin": {
    "repo-gc-python": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "python"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "repo-gc": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}
