{
  "name": "repo-gc",
  "version": "0.2.5",
  "description": "Repository hygiene analyzer — multi-language AI context efficiency",
  "license": "FSL-1.1-MIT",
  "repository": "https://github.com/repo-gc/repo-gc",
  "author": "repo-gc authors",
  "keywords": ["repo-gc", "repository", "hygiene", "ai", "llm", "context", "code-quality", "analyzer", "cli"],
  "type": "module",
  "bin": {
    "repo-gc": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "types": "./dist/index.d.ts",
  "files": ["dist", "bin"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build && cp ../../target/release/repo-gc bin/repo-gc && chmod +x bin/repo-gc"
  },
  "dependencies": {
    "repo-gc-python": "workspace:*",
    "repo-gc-shared": "workspace:*",
    "repo-gc-typescript": "workspace:*",
    "commander": "^14.0.3",
    "globby": "^15.0.0",
    "picocolors": "^1.1.0"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
