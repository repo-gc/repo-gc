{
  "name": "repo-gc-typescript",
  "version": "0.2.4",
  "description": "TypeScript/JavaScript language support for repo-gc — detects oversized files, dead modules, coupling hotspots, barrel re-exports, duplicate code, and unused imports",
  "license": "FSL-1.1-MIT",
  "repository": "https://github.com/repo-gc/repo-gc",
  "author": "repo-gc authors",
  "keywords": ["repo-gc", "typescript", "javascript", "hygiene", "ai", "llm", "context", "code-quality", "analyzer", "plugin", "oxc"],
  "type": "module",
  "bin": {
    "repo-gc-typescript": "./dist/cli.js"
  },
  "main": "./dist/plugin.js",
  "exports": {
    ".": "./dist/plugin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "repo-gc": "workspace:*",
    "oxc-parser": "^0.132.0",
    "unrs-resolver": "^1.12.2"
  },
  "devDependencies": {
    "@oxc-project/types": "^0.132.0",
    "@types/node": "^25.9.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
